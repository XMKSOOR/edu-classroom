service firebase.storage {
  match /b/{bucket}/o {
    match /assignments/{classId}/{assignId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /stream/{classId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
